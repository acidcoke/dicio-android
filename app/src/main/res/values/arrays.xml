<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phonetic words drawn on PIN-pad keys, in slot order (NATO alphabet, first ten letters).
         The order here must match the slot_a..slot_j ids in sentences/<lang>/pin_key.yml. -->
    <string-array name="va_pin_words">
        <item>Alpha</item>
        <item>Bravo</item>
        <item>Charlie</item>
        <item>Delta</item>
        <item>Echo</item>
        <item>Foxtrot</item>
        <item>Golf</item>
        <item>Hotel</item>
        <item>India</item>
        <item>Juliet</item>
    </string-array>

    <!-- Extra words allowed by the Vosk grammar while a PIN pad is on screen, so that besides the
         phonetic key words the user can still say the global commands (go back / go home / scroll /
         swipe / delete / enter / stop). Constraining recognition to this closed set makes the
         phonetic PIN words near-perfect. One word per token; localized per language. -->
    <string-array name="va_command_grammar">
        <item>press</item><item>tap</item><item>type</item>
        <item>go</item><item>move</item><item>navigate</item><item>back</item>
        <item>to</item><item>the</item><item>previous</item><item>screen</item>
        <item>page</item><item>home</item><item>main</item>
        <item>scroll</item><item>up</item><item>upward</item><item>upwards</item>
        <item>down</item><item>downward</item><item>downwards</item>
        <item>left</item><item>right</item><item>swipe</item><item>flick</item>
        <item>delete</item><item>backspace</item><item>clear</item><item>remove</item>
        <item>enter</item><item>confirm</item><item>submit</item><item>done</item>
        <item>ok</item><item>accept</item>
        <item>stop</item><item>cancel</item><item>exit</item><item>quit</item>
        <item>dismiss</item><item>listening</item><item>voice</item><item>access</item>
        <item>never</item><item>mind</item>
    </string-array>
</resources>
