<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phonetic words drawn on PIN-pad keys, in slot order (NATO alphabet, first ten letters).
         The order here must match the slot_a..slot_j ids in sentences/<lang>/pin_key.yml. -->
    <string-array name="va_pin_words">
        <item>Alpha</item>
        <item>Bravo</item>
        <item>Charlie</item>
        <item>Delta</item>
        <item>Echo</item>
        <item>Foxtrot</item>
        <item>Golf</item>
        <item>Hotel</item>
        <item>India</item>
        <item>Juliet</item>
    </string-array>

    <!-- Extra words allowed by the Vosk grammar while a PIN pad is on screen, so that besides the
         phonetic key words the user can still say the global commands (go back / go home / scroll /
         swipe / delete / enter / stop). Constraining recognition to this closed set makes the
         phonetic PIN words near-perfect. One word per token; localized per language. -->
    <string-array name="va_command_grammar">
        <item>press</item><item>tap</item><item>type</item>
        <item>click</item><item>mouse</item>
        <item>go</item><item>back</item><item>home</item>
        <item>scroll</item><item>up</item>
        <item>down</item>
        <item>left</item><item>right</item><item>swipe</item><item>flick</item>
        <item>delete</item><item>backspace</item><item>clear</item><item>remove</item>
        <item>enter</item><item>confirm</item><item>submit</item><item>done</item>
        <item>ok</item><item>accept</item>
        <item>shift</item><item>space</item>
        <item>stop</item><item>cancel</item><item>quit</item>
        <item>listening</item><item>voice</item><item>access</item>
        <item>number</item>
        <item>one</item><item>two</item><item>three</item><item>four</item>
        <item>five</item><item>six</item><item>seven</item><item>eight</item>
        <item>nine</item><item>ten</item><item>eleven</item><item>twelve</item>
        <item>thirteen</item><item>fourteen</item><item>fifteen</item><item>sixteen</item>
        <item>seventeen</item><item>eighteen</item><item>nineteen</item><item>twenty</item>
        <item>thirty</item><item>forty</item><item>fifty</item><item>sixty</item>
        <item>seventy</item><item>eighty</item><item>ninety</item><item>hundred</item>
        <!-- time -->
        <item>what</item><item>whats</item><item>time</item><item>is</item><item>it</item>
        <!-- flashlight -->
        <item>switch</item><item>on</item><item>off</item><item>activate</item>
        <item>enable</item><item>deactivate</item><item>disable</item><item>flashlight</item>
        <item>torch</item><item>flash</item><item>light</item>
        <!-- joke -->
        <item>tell</item><item>me</item><item>say</item><item>joke</item><item>jokes</item>
        <item>funny</item><item>pun</item><item>gag</item><item>prank</item>
        <item>something</item><item>fun</item>
        <!-- labels -->
        <item>show</item><item>display</item>
        <item>numbers</item><item>grid</item><item>hide</item>
        <!-- grid columns (the NATO synonyms are already in va_pin_words) -->
        <item>a</item><item>b</item><item>c</item><item>d</item>
        <item>e</item><item>f</item><item>g</item><item>h</item>
        <!-- start/stop listening -->
        <item>start</item><item>wake</item><item>word</item><item>mute</item>
        <item>unmute</item><item>microphone</item>
        <!-- media -->
        <item>play</item><item>resume</item><item>unpause</item><item>restart</item>
        <item>song</item><item>media</item><item>track</item><item>music</item>
        <item>audio</item><item>video</item><item>movie</item><item>stream</item>
        <item>film</item><item>player</item><item>continue</item><item>playing</item>
        <item>pause</item><item>halt</item><item>hold</item><item>last</item>
        <item>replay</item><item>rewind</item><item>skip</item><item>next</item>
        <item>following</item><item>jump</item>
        <item>in</item>
        <!-- notifications / quick settings -->
        <!-- NOTE: "open" is intentionally NOT in the grammar: it is also the OpenSkill trigger for
             arbitrary (open-vocab) app names, and including it makes the grammar recognizer force-fit
             app names onto grammar words (e.g. "open signal" -> "open second"). The free recognizer
             handles "open notifications" fine since both words are common vocabulary. -->
        <item>notification</item>
        <item>notifications</item><item>quick</item><item>settings</item>
        <!-- yes / no -->
        <item>yes</item><item>certainly</item><item>affirmative</item>
        <item>proceed</item><item>no</item><item>negative</item>
        <!-- weather -->
        <item>weather</item><item>how</item><item>cold</item><item>cool</item>
        <item>warm</item><item>hot</item><item>sunny</item><item>rainy</item>
        <item>raining</item><item>outside</item><item>like</item>
        <!-- timer -->
        <item>timer</item><item>set</item><item>create</item><item>end</item>
        <item>terminate</item><item>silence</item><item>quiet</item><item>bell</item>
        <item>alert</item><item>sound</item><item>ringtone</item><item>ping</item>
        <item>long</item><item>left</item><item>when</item><item>expire</item>
        <item>minute</item><item>minutes</item><item>second</item><item>seconds</item>
        <item>hour</item><item>hours</item>
        <!-- read notifications -->
        <item>read</item><item>speak</item><item>my</item>
    </string-array>

    <!-- Leading words of the open-vocabulary (capturing) skills: open/search/navigate/call/translate/
         weather questions. When the grammar recognizer hears one of these as the FIRST word of an
         utterance, the rest of the utterance (everything after this word's end timestamp) is
         re-decoded with the free recognizer for dictation, instead of being force-fit onto grammar
         words. Pure closed commands never start with one of these, so they stay fully constrained.
         These words are also added to the grammar vocabulary (in code) so they can be recognized. -->
    <string-array name="va_dictation_triggers">
        <!-- open -->
        <item>open</item><item>run</item><item>execute</item><item>view</item>
        <item>see</item><item>launch</item><item>start</item>
        <!-- search -->
        <item>search</item><item>research</item><item>seek</item><item>lookup</item>
        <item>look</item><item>find</item>
        <!-- navigation -->
        <item>navigate</item><item>take</item><item>bring</item><item>give</item>
        <!-- telephone -->
        <item>call</item><item>ring</item><item>phone</item><item>dial</item>
        <item>contact</item>
        <!-- translation -->
        <item>translate</item>
        <!-- weather (question words like what/how/is are kept constrained, not triggers) -->
        <item>weather</item>
    </string-array>

    <!-- Subset of va_dictation_triggers whose ENTIRE utterance (including the trigger word itself)
         is re-decoded by the free recognizer, instead of only the tail after the trigger. Used for
         "open", where app names must not be force-fit and the trigger word carries no useful
         grammar-side reliability worth keeping over the free recognizer's own accuracy. -->
    <string-array name="va_full_decode_triggers">
        <item>open</item>
    </string-array>
</resources>
