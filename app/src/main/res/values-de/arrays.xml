    <!-- Führende Wörter der Skills mit freier Eingabe (öffnen/suchen/navigieren/anrufen/übersetzen/
         Wetterfragen). Hört der Grammatik-Erkenner eines davon als ERSTES Wort, wird der Rest der
         Äußerung (alles nach dem End-Zeitstempel dieses Wortes) mit dem freien Erkenner als Diktat
         neu dekodiert, statt auf Grammatikwörter gezwungen zu werden. Reine geschlossene Befehle
         beginnen nie mit einem dieser Wörter und bleiben so vollständig eingeschränkt. Diese Wörter
         werden (im Code) auch dem Grammatik-Vokabular hinzugefügt, damit sie erkannt werden. -->
    <string-array name="va_dictation_triggers">
        <!-- öffnen -->
        <item>öffne</item><item>oeffne</item><item>starte</item><item>zeige</item>
        <item>zeig</item>
        <!-- suchen -->
        <item>finde</item><item>suche</item><item>schlage</item>
        <!-- navigation -->
        <item>navigiere</item><item>führe</item><item>fuehre</item><item>bringe</item>
        <item>leite</item><item>route</item>
        <!-- telefon -->
        <item>ruf</item><item>rufe</item>
        <!-- übersetzung -->
        <item>übersetz</item><item>bitte</item><item>sag</item>
        <!-- wetter (Fragewörter wie was/wie/wo/ist bleiben eingeschränkt, keine Trigger) -->
        <item>regnet</item><item>schneit</item><item>hagelt</item>
        <item>scheint</item><item>wetter</item>
    </string-array>

    <!-- Teilmenge von va_dictation_triggers, deren GESAMTE Äußerung (inklusive des Trigger-Worts
         selbst) mit dem freien Erkenner neu dekodiert wird, statt nur der Rest nach dem Trigger.
         Nur öffne/oeffne, da starte/zeige/zeig auch außerhalb von "öffnen" verwendet werden. -->
    <string-array name="va_full_decode_triggers">
        <item>öffne</item><item>oeffne</item>
    </string-array>
